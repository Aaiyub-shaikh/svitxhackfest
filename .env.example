# Vite environment variables for Smart Farming Advisory Platform
# Copy to .env.local and fill values

# ML disease detection API (FastAPI/Flask). Example: http://localhost:8000
VITE_ML_API_URL=

# Streamlit app URL (optional). Example: http://localhost:8501
VITE_STREAMLIT_URL=

# OpenWeatherMap API key for weather & rainfall forecast
VITE_OPENWEATHER_API_KEY=
